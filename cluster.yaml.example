# cluster.yaml.example
#
# Copy this file to cluster.yaml (git-ignored — see .gitignore) and edit it, then run
# hack/customize-cluster.sh. cluster.yaml is the single declarative input the script
# reads: it drives which literal names get substituted throughout this repo and which
# optional component directories survive. It is NOT committed to the customized repo
# afterward (the script deletes it once customization is done) — the substituted
# manifests themselves are the record of what was chosen, same as every other config
# in this platform, not a second parallel source of truth that could drift from them.
#
# See idp/docs/cluster-provisioning.md for the full design and the invariants this
# schema encodes.

# The kubectl context name for the new cluster, e.g. kind-staging. Also becomes the
# cluster-registry entry name (gitops-cluster-dev/00-bootstrap/cluster-registry/
# <clusterName>.yaml) and feeds every per-cluster identity string in this repo
# (Infisical project slugs, ArgoCD repo-creds naming, etc).
clusterName: kind-staging

# The GitHub repo name this customized checkout will be pushed to, e.g.
# gitops-cluster-kind-staging. Deliberately an explicit field, not derived from
# clusterName — the two existing real repos don't follow one consistent rule
# (gitops-cluster-dev drops the "kind-" prefix its own clusterName kind-dev carries;
# gitops-cluster-kind-prod keeps it), so guessing would get it wrong as often as
# right. Pick whatever you'll actually name the new GitHub repo.
clusterRepoName: gitops-cluster-kind-staging

# This cluster's record in the fleet's clusters.yaml (docs/clusters-file.md; glidepath ADR-0024). Required.
#   zone: lower | upper. upper = nothing below it holds a write credential to it; changes reach it only through
#         reviewed merges its own Argo CD syncs. The control-plane cluster is always lower.
#   roles: any of control-plane (the fleet's one CI/CD control plane and Bootstrap-tier Crossplane), workloads,
#         platform-services. Only a control-plane cluster may enable components.crossplane.providerGithub or
#         components.platformCicd - those are centralized on the fleet's one control plane regardless of fleet size
#         (service-catalog-design.md §0). hack/customize-cluster.sh refuses a violation rather than correcting it.
# (Replaces `type: dev|upper`; the script still reads an old `type` and maps dev -> lower + control-plane.)
zone: upper
roles: [workloads]

# Defaults to <clusterRepoName>-tenants (this repo's own name, minus "gitops-cluster-",
# with "-tenants" appended) via the same substitution the script applies to every
# gitops-cluster-dev self-reference in this repo. Override only if you need to break
# that convention on purpose (gitops-cluster-dev's own tenants repo, gitops-cluster-
# dev-tenants, is the one existing exception — a historical name kept because renaming
# a live, already-wired repo was judged too disruptive; new clusters should follow the
# convention, not repeat the exception).
tenantsRepo: gitops-cluster-kind-staging-tenants

# Every repoURL in this template (self-references AND fixed platform dependencies like
# idp-service-catalog/platform-cicd) is hardcoded to https://github.com/jfillman/... -
# this section makes both the host and the owner/org configurable, e.g. for forking
# this platform to a different GitHub account or a self-hosted GitLab/GHE instance.
# Substitution is scoped to the exact "github.com/jfillman" literal (with and without
# the https:// prefix, for prose mentions) - NOT a bare "github.com" replace, which
# would also wrongly rewrite genuinely third-party upstream repoURLs this template
# vendors from (e.g. 10-crds-operators/sloth/application.yaml's own
# https://github.com/slok/sloth.git, and plain comment mentions of
# github.com/argoproj/argo-cd or github.com/crossplane-contrib/*).
scm:
  host: github.com
  owner: jfillman

# ghcr.io/jfillman/function-rollout-watcher - the one org-owned container image this
# template references directly (10-crds-operators/crossplane/functions.yaml). Public,
# third-party OCI/chart registries used throughout this repo (xpkg.upbound.io,
# charts.external-secrets.io, dl.cloudsmith.io, etc) are NOT touched by this - they're
# shared upstream sources, not something a fork of this platform would own a copy of.
registry:
  host: ghcr.io
  owner: jfillman

argocd:
  # Pinned, never "latest" — see 01-argocd-platform/install.yaml's own header for why.
  # This field is documentation of what's vendored, not something the script derives
  # install.yaml from — install.yaml is ~34k lines of rendered chart output, version-
  # specific in ways a find/replace can't safely touch. To pin a different ArgoCD
  # version, regenerate install.yaml yourself before running customize-cluster.sh (see
  # that file's own header for the exact command) and update this field to match.
  chartVersion: "10.3.2"
  appVersion: "v3.5.0"

components:
  crossplane:
    enabled: true               # always true today — every cluster in this fleet runs Crossplane
    providerGithub: false        # type: upper MUST be false — see the invariant above
    providerKubernetes: true     # always true — every Attached-tier XRD needs this
  certManager: true
  externalSecrets: true
  # Which cluster runs the actual Infisical server. Exactly one cluster in the fleet
  # should ever set this true (idp/docs/gitops-strategy.md's infisicalHost note on
  # kind-dev's own cluster-registry entry) — every other cluster is a remote consumer,
  # authenticating to that one instance via Universal Auth instead of running its own.
  secrets:
    infisicalHost: false
  argoRollouts: true
  contour: true
  sloth: true
  serviceCatalog:
    enabled: true
    # full: every XRD/Composition in idp-service-catalog, including Bootstrap-tier
    #   (NodeJSApplication/ApplicationEnvironment) — dev cluster only, matches the
    #   providerGithub invariant above (Bootstrap-tier XRDs are pure provider-github
    #   writers).
    # attached-tier-only: just the XRDs that compose native in-cluster resources
    #   directly (SLO, SecretStore, RolloutWatch today) — required on every upper
    #   cluster, since those have no meaning without Crossplane actually running
    #   where the resource lands. See idp/docs/service-catalog-design.md §0.
    scope: attached-tier-only
  policy: false                  # Kyverno + the testkube-secret-usage policy (real as of
                                  # 2026-08-24). Only meaningful alongside platformCicd:
                                  # true - the one policy shipped so far governs Testkube
                                  # TestWorkflow secret usage. Default false since not
                                  # every cluster runs platform-cicd's Testkube install.
  observability: true
  # platform-cicd's own control plane (Tekton/PaC/the CDEvents broker) — type: upper
  # MUST be false, same invariant as providerGithub above. Only ever true on the one
  # dev cluster that runs it (today: kind-dev).
  platformCicd: false
  # The fleet's developer portal (idp/docs/backstage-design.md) — upstream Backstage,
  # its own dedicated Postgres, deployed straight to this cluster rather than through
  # the usual tenant/service-catalog flow. Same singleton convention as
  # secrets.infisicalHost/platformCicd above: exactly one cluster in the fleet should
  # ever set this true (today: kind-man) — not enforced by this script the same hard
  # way providerGithub/platformCicd are, since nothing about running it elsewhere
  # would corrupt shared state the way those two would, but still a real fleet-wide
  # convention, not a per-cluster style choice.
  backstage: false
  # Autopilot (AI agent workloads, hangar docs/autopilot/design.md): its namespaces today, Clearance and the AgentRun
  # catalog later (55-autopilot/README.md). Dev only: refused on a cluster without the control-plane role, and needs
  # serviceCatalog scope full. Runs still wait for airframe.autopilotReady, set after the network-policy canary passes.
  autopilot: false
