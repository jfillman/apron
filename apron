#!/usr/bin/env bash
# apron: deploy Hangar onto a Kubernetes cluster (docs/cli.md).
#
# Onboarding an existing cluster is the primary path. The kiac and kind runtimes first create a local cluster, then run
# the very same onboarding. Everything cluster-specific comes from the cluster repo's cluster.yaml, resolved by
# hack/render.py --print-values; this script holds no cluster names and no default owner.
#
#   apron init <profile> --name N --runtime R --out DIR --repo-url URL --scm-owner O [...]
#   apron render --out DIR
#   apron up --out DIR [--dry-run] [--yes] [--rename-context FROM]
#   apron fleet add --from DIR --fleet FILE | fleet set-infisical --fleet FILE --org-id X --url U [--in-cluster-url U]
#   apron identity --out DIR [--node-exec CMD] [--dry-run]
#   apron verify|resume --out DIR ;  apron down --out DIR --yes
set -euo pipefail

APRON_ROOT="${APRON_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PYTHON="${PYTHON:-python3}"

# --- output ---------------------------------------------------------------------------------------------------------
if [ -t 1 ]; then C_STEP=$'\033[1;36m'; C_OK=$'\033[1;32m'; C_WARN=$'\033[1;33m'; C_ERR=$'\033[1;31m'; C_OFF=$'\033[0m'
else C_STEP=""; C_OK=""; C_WARN=""; C_ERR=""; C_OFF=""; fi
step() { echo "${C_STEP}==> $*${C_OFF}"; }
ok()   { echo "  ${C_OK}ok${C_OFF} $*"; }
warn() { echo "${C_WARN}warning: $*${C_OFF}" >&2; }
die()  { echo "${C_ERR}error: $*${C_OFF}" >&2; exit 1; }
require() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed"; }

DRY_RUN=false
# run CMD...: print the command, then run it (or only print it under --dry-run).
run() {
  echo "  + $*"
  [ "${DRY_RUN}" = true ] || "$@"
}

# --- validation -----------------------------------------------------------------------------------------------------
valid_name()  { [[ "$1" =~ ^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$ ]]; }
valid_owner() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$ ]] && [[ "$1" != *--* ]]; }
check_name()  { valid_name "$1"  || die "invalid name '$1': must be a DNS-1123 label (lowercase letters, digits, '-', max 63)"; }
check_owner() { valid_owner "$1" || die "invalid owner '$1': must be a GitHub user or organization name"; }

# parse_repo_url URL -> sets REPO_HOST REPO_OWNER REPO_NAME (https://HOST/OWNER/NAME[.git] or git@HOST:OWNER/NAME[.git])
parse_repo_url() {
  local u="$1" rest
  case "$u" in
    https://*) rest="${u#https://}"; REPO_HOST="${rest%%/*}"; rest="${rest#*/}" ;;
    git@*:*)   rest="${u#git@}"; REPO_HOST="${rest%%:*}"; rest="${rest#*:}" ;;
    *) die "repo URL '$u' must be https://HOST/OWNER/NAME(.git) or git@HOST:OWNER/NAME(.git)" ;;
  esac
  rest="${rest%.git}"; rest="${rest%/}"
  REPO_OWNER="${rest%%/*}"; REPO_NAME="${rest#*/}"
  [ -n "${REPO_OWNER}" ] && [ -n "${REPO_NAME}" ] && [[ "${REPO_NAME}" != */* ]] || die "cannot read OWNER/NAME from '$u'"
  check_owner "${REPO_OWNER}"
}

# --- resolved values ------------------------------------------------------------------------------------------------
cluster_file() { echo "$1/cluster.yaml"; }
need_cluster_dir() {
  [ -n "$1" ] || die "--out DIR is required"
  [ -f "$(cluster_file "$1")" ] || die "$(cluster_file "$1") not found (run apron init first)"
}

# load_values DIR: resolve the cluster's values once into VALUES (JSON) and the handful of fields every command uses.
load_values() {
  local dir="$1"
  require jq
  VALUES="$("${PYTHON}" "${APRON_ROOT}/hack/render.py" --cluster "$(cluster_file "${dir}")" --print-values \
    --apron-root "${APRON_ROOT}")" || die "hack/render.py --print-values failed"
  NAME="$(val '.name')"; check_name "${NAME}"
  PROFILE="$(val '.profile')"
  RUNTIME="$(val '.runtime.type')"
  CONTEXT="$(val '.context // .name')"
  [ "${CONTEXT}" = "${NAME}" ] || die "context '${CONTEXT}' differs from name '${NAME}': one name for cluster, context, registry entry"
  case "${RUNTIME}" in existing|kiac|kind) ;; *) die "unknown runtime '${RUNTIME}' (existing|kiac|kind)" ;; esac
}
# val JQ: one field of the resolved values, empty string for null.
val() { jq -r "($1) // empty | if type == \"array\" then join(\",\") else . end" <<<"${VALUES}"; }
# rt KEY: a runtime setting, wherever render.py puts it (runtime.<rt>.KEY or <rt>.KEY).
rt() { val ".runtime.${RUNTIME}.$1"; }

# --- subcommand: init -----------------------------------------------------------------------------------------------
usage_init() { cat <<'EOF'
apron init <dev|prod> --name N --runtime existing|kiac|kind --out DIR --repo-url URL --scm-owner OWNER
           [--tenants-repo URL] [--registry-owner OWNER] [--domain D] [--context CTX]
           [--fleet-hub NAME --fleet-repo-url URL] [--tower-cluster NAME] [--set k=v]... [--create-repos] [--push]
Writes DIR/cluster.yaml (hack/new_cluster.py), validates it (hack/check.py), renders the cluster repo into DIR
(hack/render.py) and makes DIR a git repo whose origin is --repo-url.
  --tenants-repo     default: the cluster repo's name + "-tenants", same owner
  --context          runtime existing: the kubeconfig context to adopt; when it is not --name, apron up renames it
  --fleet-hub        the control-plane cluster's name (every cluster but the hub)
  --fleet-repo-url   the hub's cluster repo, whose clusters.yaml the registry reads (with --fleet-hub)
  --tower-cluster    the cluster Tower runs on (when the profile turns Tower access on)
  --create-repos     gh repo create OWNER/NAME --private for the cluster and tenants repos, only when missing
  --push             commit the rendered tree and push it to main of the cluster repo
EOF
}
cmd_init() {
  local profile="" name="" runtime="" out="" repo_url="" tenants="" scm_owner="" reg_owner="" ctx="" domain=""
  local fleet_hub="" fleet_repo="" tower=""
  local create=false push=false; local -a sets=()
  [ $# -gt 0 ] && [[ "$1" != -* ]] && { profile="$1"; shift; }
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) name="$2"; shift 2 ;;            --runtime) runtime="$2"; shift 2 ;;
      --out) out="$2"; shift 2 ;;              --repo-url) repo_url="$2"; shift 2 ;;
      --tenants-repo) tenants="$2"; shift 2 ;; --scm-owner) scm_owner="$2"; shift 2 ;;
      --registry-owner) reg_owner="$2"; shift 2 ;; --context) ctx="$2"; shift 2 ;;
      --domain) domain="$2"; shift 2 ;;        --set) sets+=("$2"); shift 2 ;;
      --fleet-hub) fleet_hub="$2"; shift 2 ;;  --fleet-repo-url) fleet_repo="$2"; shift 2 ;;
      --tower-cluster) tower="$2"; shift 2 ;;
      --create-repos) create=true; shift ;;    --push) push=true; shift ;;
      -h|--help) usage_init; return 0 ;;       *) die "init: unknown argument $1 (apron init --help)" ;;
    esac
  done
  case "${profile}" in dev|prod) ;; *) die "init: profile must be dev or prod (apron init --help)" ;; esac
  [ -n "${name}" ] || die "init: --name is required"; check_name "${name}"
  case "${runtime}" in existing|kiac|kind) ;; *) die "init: --runtime must be existing, kiac or kind" ;; esac
  [ -n "${out}" ] || die "init: --out is required"
  [ -n "${repo_url}" ] || die "init: --repo-url is required"
  [ -n "${scm_owner}" ] || die "init: --scm-owner is required (there is no default owner)"
  check_owner "${scm_owner}"; [ -z "${reg_owner}" ] || check_owner "${reg_owner}"
  [ -z "${ctx}" ] || [ "${runtime}" = existing ] || [ "${ctx}" = "${name}" ] \
    || die "init: --context is for runtime existing; ${runtime} creates context ${runtime}-${name} and apron up renames it to ${name}"
  [ -z "${fleet_hub}" ] || check_name "${fleet_hub}"; [ -z "${tower}" ] || check_name "${tower}"
  [ -z "${fleet_repo}" ] || parse_repo_url "${fleet_repo}"
  parse_repo_url "${repo_url}"; local host="${REPO_HOST}" owner="${REPO_OWNER}" repo="${REPO_NAME}"
  local t_owner="${owner}" t_repo="${repo}-tenants"
  if [ -n "${tenants}" ]; then parse_repo_url "${tenants}"; t_owner="${REPO_OWNER}"; t_repo="${REPO_NAME}"; fi

  local -a set_args=(--repo-url "${repo_url}" --scm-host "${host}" --scm-owner "${scm_owner}")
  local f v
  for f in tenants-repo:tenants registry-owner:reg_owner domain:domain fleet-hub:fleet_hub \
           fleet-repo-url:fleet_repo tower-cluster:tower context:ctx; do
    v="${f#*:}"; v="${!v}"; [ -z "${v}" ] || set_args+=("--${f%%:*}" "${v}")
  done
  [ -z "${ctx}" ] || [ "${ctx}" = "${name}" ] || set_args+=(--set "runtime.existing.renameContext=true")
  local s; for s in ${sets[@]+"${sets[@]}"}; do [[ "$s" == *=* ]] || die "--set expects k=v, got '$s'"; set_args+=(--set "$s"); done

  mkdir -p "${out}"
  local cf; cf="$(cluster_file "${out}")"
  step "cluster.yaml"
  if [ -f "${cf}" ]; then
    ok "${cf} exists; keeping it (edit it, then apron render)"
  else
    "${PYTHON}" "${APRON_ROOT}/hack/new_cluster.py" --profile "${profile}" --name "${name}" --runtime "${runtime}" \
      --apron-root "${APRON_ROOT}" "${set_args[@]}" >"${cf}.tmp" || { rm -f "${cf}.tmp"; die "hack/new_cluster.py failed"; }
    mv "${cf}.tmp" "${cf}"; ok "wrote ${cf}"
  fi
  check_and_render "${out}"
  git_setup "${out}" "${repo_url}"
  [ "${create}" = false ] || create_repos "${owner}/${repo}" "${t_owner}/${t_repo}"
  [ "${push}" = false ] || push_repo "${out}" "${repo_url}"
  step "next: apron up --out ${out}"
}

check_and_render() {
  local dir="$1" cf; cf="$(cluster_file "$1")"
  step "check"
  "${PYTHON}" "${APRON_ROOT}/hack/check.py" --cluster "${cf}" --apron-root "${APRON_ROOT}" || die "hack/check.py found violations (above); fix ${cf}"
  ok "cluster.yaml is valid"
  step "render into ${dir}"
  "${PYTHON}" "${APRON_ROOT}/hack/render.py" --cluster "${cf}" --out "${dir}" --apron-root "${APRON_ROOT}" \
    || die "hack/render.py failed"
  ok "rendered"
}

git_setup() {
  local dir="$1" url="$2" cur
  step "git"
  if [ ! -d "${dir}/.git" ]; then git -C "${dir}" init -q -b main; ok "git init ${dir}"; fi
  cur="$(git -C "${dir}" config --get remote.origin.url 2>/dev/null || true)"
  if [ -z "${cur}" ]; then git -C "${dir}" remote add origin "${url}"; ok "origin = ${url}"
  elif [ "${cur}" = "${url}" ]; then ok "origin = ${url}"
  else die "${dir} already has origin ${cur}, not ${url}: refusing to change it"; fi
}

create_repos() {
  require gh
  step "GitHub repos"
  # create_repos CLUSTER_REPO TENANTS_REPO. The tenants repo gets a README commit: the control plane's
  # tenant-onboarding ApplicationSet lists its refs, and a repo with no branch at all leaves it Degraded
  # ("remote repository is empty"). The cluster repo stays empty, since --push writes its first commit.
  local r extra
  for r in "$@"; do
    extra=(); [ "${r}" = "$1" ] || extra=(--add-readme)
    if gh repo view "${r}" >/dev/null 2>&1; then echo "  skipped ${r}: already exists (left untouched)"
    else gh repo create "${r}" --private "${extra[@]}" >/dev/null; ok "created ${r} (private${extra:+, with a README})"; fi
  done
}

push_repo() {
  local dir="$1" url="$2"
  step "push"
  [ "$(git -C "${dir}" config --get remote.origin.url)" = "${url}" ] || die "origin of ${dir} is not ${url}; not pushing"
  git -C "${dir}" add -A
  if git -C "${dir}" diff --cached --quiet; then ok "nothing new to commit"
  else git -C "${dir}" commit -q -m "apron: render cluster repo"; ok "committed"; fi
  git -C "${dir}" push -u origin HEAD:main
  ok "pushed to ${url} main"
}

# --- subcommand: render ---------------------------------------------------------------------------------------------
usage_render() { echo "apron render --out DIR   re-validate and re-render DIR from DIR/cluster.yaml (day 2), then show git status"; }
cmd_render() {
  local out=""
  while [ $# -gt 0 ]; do case "$1" in --out) out="$2"; shift 2 ;; -h|--help) usage_render; return 0 ;;
    *) die "render: unknown argument $1" ;; esac; done
  need_cluster_dir "${out}"
  check_and_render "${out}"
  if [ -d "${out}/.git" ]; then
    step "changes"; local st; st="$(git -C "${out}" status --short)"
    if [ -z "${st}" ]; then ok "no changes"; else echo "${st}"; echo "  $(wc -l <<<"${st}" | tr -d ' ') path(s) changed; review, commit and push"; fi
  fi
}

# --- subcommand: up -------------------------------------------------------------------------------------------------
usage_up() { cat <<'EOF'
apron up --out DIR [--dry-run] [--yes] [--rename-context FROM]
Idempotent, resumable. Phase 1 (runtime): create the kiac/kind cluster if missing, or check an existing one; make its
kubectl context equal its name. Phase 2 (onboard, every runtime): CNI if the runtime needs one, Argo CD, then stop
until the hand-planted Secrets exist (prints the commands; re-run apron up), then the root app-of-apps.
  --dry-run          print every step and command, touch nothing
  --yes              do not ask before creating the cluster and applying to it
  --rename-context   existing runtime: the context to rename to the cluster's name
EOF
}
cmd_up() {
  local out="" yes=false rename_from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --out) out="$2"; shift 2 ;; --dry-run) DRY_RUN=true; shift ;; --yes) yes=true; shift ;;
      --rename-context) rename_from="$2"; shift 2 ;; -h|--help) usage_up; return 0 ;;
      *) die "up: unknown argument $1" ;;
    esac
  done
  need_cluster_dir "${out}"; load_values "${out}"
  require kubectl
  if [ -z "${rename_from}" ] && [ "${RUNTIME}" = existing ]; then
    rename_from="$(rt context)"; [ "${rename_from}" != "${NAME}" ] || rename_from=""
  fi
  echo "cluster ${NAME}: profile ${PROFILE}, runtime ${RUNTIME}$( [ "${DRY_RUN}" = true ] && echo ' (dry run)')"
  confirm "${yes}" "create/onboard cluster ${NAME} (context ${NAME})"

  step "phase 1: runtime (${RUNTIME})"
  case "${RUNTIME}" in
    kiac) runtime_kiac ;; kind) runtime_kind "${out}" ;; existing) runtime_existing "${rename_from}" ;;
  esac
  ensure_context "${rename_from}"
  kiac_max_pods

  step "phase 2: onboard"
  install_cni
  install_argocd "${out}"
  check_secrets || return 0
  apply_root "${out}"
  print_next_steps "${out}"
}

confirm() {
  [ "$1" = true ] || [ "${DRY_RUN}" = true ] && return 0
  [ -t 0 ] || die "not a terminal: pass --yes to $2"
  local a; read -r -p "$2? [y/N] " a; [[ "$a" =~ ^[Yy]$ ]] || die "aborted"
}

kiac_exists() { kiac get clusters 2>/dev/null | awk 'NR>1 || !/NAME/ {print $1}' | grep -qx "${NAME}"; }
kind_exists() { kind get clusters 2>/dev/null | grep -qx "${NAME}"; }

runtime_kiac() {
  require kiac
  local -a args=(kiac create cluster --name "${NAME}")
  local k v
  for k in workers:workers cni:cni kernel:kernel cpus:cpus cp-memory:cpMemory; do
    v="$(rt "${k#*:}")"; [ -z "$v" ] || args+=("--${k%%:*}" "$v")
  done
  # No --gateway: Apron's own templates install Traefik on every runtime.
  if [ "${DRY_RUN}" = false ] && kiac_exists; then ok "kiac cluster ${NAME} exists; not creating"; return; fi
  [ "${DRY_RUN}" = false ] || echo "  (skipped if kiac get clusters lists ${NAME})"
  run "${args[@]}"
}

# kiac_max_pods: kiac has no kubelet setting, and the kubelet's default of 110 pods is below what the dev profile runs
# on one node. Set runtime.kiac.maxPods in each node's /var/lib/kubelet/config.yaml and restart the kubelet, only where
# the node's pod capacity differs. Idempotent; up and resume both run it (kind gets it from its kind config instead).
kiac_max_pods() {
  [ "${RUNTIME}" = kiac ] || return 0
  local want exec node have i wait="${APRON_NODE_WAIT:-180}"
  want="$(rt maxPods)"; [ -n "${want}" ] || return 0
  exec="$(val '.runtime.nodeExec')"; [ -n "${exec}" ] || die "resolved values have no runtime.nodeExec"
  step "kubelet maxPods ${want}"
  local script="f=/var/lib/kubelet/config.yaml; if grep -q '^maxPods:' \$f; then sed -i 's/^maxPods:.*/maxPods: ${want}/' \$f; else echo 'maxPods: ${want}' >>\$f; fi; systemctl restart kubelet"
  if [ "${DRY_RUN}" = true ]; then echo "  + ${exec} <node> sh -c \"${script}\"   (each node whose pod capacity is not ${want})"; return; fi
  for node in $(kubectl --context "${NAME}" get nodes -o jsonpath='{.items[*].metadata.name}'); do
    have="$(kubectl --context "${NAME}" get node "${node}" -o jsonpath='{.status.capacity.pods}' 2>/dev/null || true)"
    if [ "${have}" = "${want}" ]; then ok "${node}: maxPods ${have}"; continue; fi
    # shellcheck disable=SC2086
    run ${exec} "${node}" sh -c "${script}" </dev/null || die "could not set maxPods on ${node}"
    for ((i = 0; i < wait; i += 5)); do
      have="$(kubectl --context "${NAME}" get node "${node}" -o jsonpath='{.status.capacity.pods}' 2>/dev/null || true)"
      [ "${have}" = "${want}" ] && break; sleep 5
    done
    if [ "${have}" = "${want}" ]; then ok "${node}: maxPods ${want}"; else warn "${node} still reports pod capacity '${have}' after ${wait}s"; fi
  done
}

runtime_kind() {
  require kind
  local dir="$1" cfg
  cfg="$(rt config)"; [ -n "${cfg}" ] || die "resolved values give no runtime.kind.config"
  [[ "${cfg}" = /* ]] || cfg="${dir}/${cfg}"
  [ -f "${cfg}" ] || [ "${DRY_RUN}" = true ] || die "kind config ${cfg} (from resolved values) is missing: apron render --out ${dir}"
  if [ "${DRY_RUN}" = false ] && kind_exists; then ok "kind cluster ${NAME} exists; not creating"; return; fi
  [ "${DRY_RUN}" = false ] || echo "  (skipped if kind get clusters lists ${NAME})"
  run kind create cluster --name "${NAME}" --config "${cfg}"
}

runtime_existing() {
  local ctx="${1:-${NAME}}"
  if [ -z "$1" ] && [ "${DRY_RUN}" = false ] && ! kubectl config get-contexts -o name 2>/dev/null | grep -qx "${NAME}"; then
    die "no kubectl context named ${NAME}. The context must equal the cluster name: pass --rename-context <current-context>"
  fi
  if [ "${DRY_RUN}" = true ]; then echo "  + kubectl --context ${ctx} get --raw /readyz"; return; fi
  kubectl --context "${ctx}" get --raw /readyz >/dev/null 2>&1 || die "context ${ctx} is not reachable (kubectl --context ${ctx} get --raw /readyz)"
  ok "${ctx} is ready"
}

# ensure_context [FROM]: make the cluster's kubectl context be its name. Looks at what exists rather than assuming.
ensure_context() {
  local from="$1" have cand
  step "context ${NAME}"
  if [ "${DRY_RUN}" = true ]; then
    case "${RUNTIME}" in
      kiac|kind) echo "  + kubectl config rename-context ${RUNTIME}-${NAME} ${NAME}   (if ${NAME} is missing and ${RUNTIME}-${NAME} exists)" ;;
      existing) [ -z "${from}" ] || echo "  + kubectl config rename-context ${from} ${NAME}" ;;
    esac
    echo "  + kubectl --context ${NAME} get --raw /readyz"; return
  fi
  have="$(kubectl config get-contexts -o name 2>/dev/null || true)"
  if ! grep -qx "${NAME}" <<<"${have}"; then
    case "${RUNTIME}" in
      kiac|kind) cand="${RUNTIME}-${NAME}" ;;
      existing) [ -n "${from}" ] || die "no context named ${NAME}. The context must equal the cluster name: pass --rename-context <current-context>"
                cand="${from}" ;;
    esac
    grep -qx "${cand}" <<<"${have}" || die "neither context ${NAME} nor ${cand} exists (kubectl config get-contexts)"
    run kubectl config rename-context "${cand}" "${NAME}"
  else
    ok "context ${NAME} exists"
  fi
  kubectl --context "${NAME}" get --raw /readyz >/dev/null 2>&1 || die "context ${NAME} is not reachable"
  ok "context ${NAME} reachable"
}

kc() { run kubectl --context "${NAME}" "$@"; }

install_cni() {
  local manifest; manifest="$(val '.cni.manifest')"
  if [ -z "${manifest}" ]; then ok "CNI: provided by the runtime"; return; fi
  if [ "${DRY_RUN}" = false ] && kubectl --context "${NAME}" -n kube-system get daemonset calico-node >/dev/null 2>&1; then
    ok "CNI already installed"; return
  fi
  echo "  CNI: $(val '.cni.name') $(val '.cni.version')"
  kc apply --server-side -f "${manifest}"
}

# find_rendered DIR JQ DEFAULT: a path in the rendered tree, from resolved values when given.
find_rendered() {
  local dir="$1" p; p="$(val "$2")"; [ -n "$p" ] || p="$3"
  [ -n "$p" ] || die "resolved values give no $2"
  [[ "$p" = /* ]] || p="${dir}/${p}"
  [ -f "$p" ] || [ "${DRY_RUN}" = true ] || die "$p is missing from the rendered tree (apron render --out ${dir})"
  echo "$p"
}

install_argocd() {
  local dir="$1" install
  install="$(find_rendered "${dir}" '.argocd.platform.install' "")"
  if [ "${DRY_RUN}" = false ] && kubectl --context "${NAME}" get namespace argocd >/dev/null 2>&1; then ok "namespace argocd exists"
  else kc create namespace argocd; fi
  kc apply --server-side -n argocd -f "${install}"
}

# required_secrets: lines "namespace<TAB>name<TAB>command template", from the resolved values' bootstrapSecrets.
required_secrets() {
  jq -r '(.bootstrapSecrets // [])[] | [.namespace, .name, (.create // ""), (.why // "")] | @tsv' <<<"${VALUES}"
}

# check_secrets: existence only (never reads data). Returns 1 after printing what to create when any is missing.
check_secrets() {
  step "hand-planted Secrets"
  local ns name cmd why missing=0
  while IFS=$'\t' read -r ns name cmd why; do
    [ -n "${name}" ] || continue
    if [ "${DRY_RUN}" = true ]; then echo "  + kubectl --context ${NAME} -n ${ns} get secret ${name}   (existence only)"; continue; fi
    if kubectl --context "${NAME}" -n "${ns}" get secret "${name}" -o name >/dev/null 2>&1; then ok "${ns}/${name}"
    else
      missing=$((missing + 1))
      echo "  missing ${ns}/${name}${why:+ (${why})}. Create it yourself; never paste the values into chat or commit them:"
      echo "    ${cmd:-kubectl --context ${NAME} -n ${ns} create secret generic ${name} --from-literal=<key>=<value>}"
    fi
  done < <(required_secrets)
  if [ "${missing}" -gt 0 ]; then
    echo
    echo "${missing} Secret(s) missing. Create them, then re-run apron up to continue."
    return 1
  fi
}

apply_root() {
  local root; root="$(find_rendered "$1" '.rootApp' "")"
  kc apply -f "${root}"
}

print_next_steps() {
  local dir="$1" doc
  step "next steps"
  for doc in "${dir}/$(val '.nextStepsDoc // "NEXT-STEPS.md"')" "${APRON_ROOT}/docs/after-up.md"; do
    [ -f "${doc}" ] && { echo "  (from ${doc})"; sed -e "s/<name>/${NAME}/g" "${doc}"; return; }
  done
  echo "  see docs/after-up.md"
}

# --- subcommand: fleet ----------------------------------------------------------------------------------------------
usage_fleet() { cat <<'EOF'
apron fleet add --from DIR --fleet FILE
    add or update DIR's cluster record (name, zone, roles, tenantsRepo, serviceAccountIssuer, readiness flags false)
    in the fleet's clusters.yaml (the control-plane cluster repo's), and ensure the top-level scm: {owner} block
apron fleet set-infisical --fleet FILE --org-id X --url U [--in-cluster-url U]
EOF
}
cmd_fleet() {
  local sub="${1:-}"; [ $# -gt 0 ] && shift
  case "${sub}" in -h|--help|"") usage_fleet; return 0 ;; esac
  local from="" fleet="" org="" url="" incl=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) from="$2"; shift 2 ;; --fleet) fleet="$2"; shift 2 ;; --org-id) org="$2"; shift 2 ;;
      --url) url="$2"; shift 2 ;; --in-cluster-url) incl="$2"; shift 2 ;; -h|--help) usage_fleet; return 0 ;;
      *) die "fleet: unknown argument $1" ;;
    esac
  done
  [ -n "${fleet}" ] || die "fleet: --fleet FILE is required"
  case "${sub}" in
    add) need_cluster_dir "${from}"; load_values "${from}"
         "${PYTHON}" "${APRON_ROOT}/hack/apron_fleet.py" add --fleet "${fleet}" --values-json "${VALUES}" ;;
    set-infisical) [ -n "${org}" ] && [ -n "${url}" ] || die "fleet set-infisical: --org-id and --url are required"
         "${PYTHON}" "${APRON_ROOT}/hack/apron_fleet.py" set-infisical --fleet "${fleet}" --org-id "${org}" --url "${url}" \
           ${incl:+--in-cluster-url "${incl}"} ;;
    -h|--help|"") usage_fleet ;;
    *) die "fleet: unknown subcommand ${sub}" ;;
  esac
}

# --- subcommand: identity -------------------------------------------------------------------------------------------
usage_identity() { cat <<'EOF'
apron identity --out DIR [--node-exec CMD] [--dry-run]
Makes https://<issuerBase>/oidc/<name> the cluster's ServiceAccount issuer (hack/cluster-identity.sh issuer).
--node-exec default: kiac "container exec -i <node>", kind "docker exec -i <node>"; override for podman or ssh
(e.g. "ssh HOST podman exec -i <node>"). Not for existing (managed) clusters: they publish their own issuer.
Publish the keys afterwards: hack/cluster-identity.sh publish --context <name> --issuer URL --out DIR
EOF
}
cmd_identity() {
  local out="" node_exec=""; local -a extra=()
  while [ $# -gt 0 ]; do
    case "$1" in --out) out="$2"; shift 2 ;; --node-exec) node_exec="$2"; shift 2 ;; --dry-run) extra+=(--dry-run); DRY_RUN=true; shift ;;
      -h|--help) usage_identity; return 0 ;; *) die "identity: unknown argument $1" ;; esac
  done
  need_cluster_dir "${out}"; load_values "${out}"
  [ "${RUNTIME}" != existing ] || die "runtime existing: a managed cluster publishes its own issuer and its API server flags are not ours to change (docs/cluster-identity.md, Managed clusters)"
  local issuer node prefix
  issuer="$(val '.issuer')"; [ -n "${issuer}" ] || die "resolved values have no issuer"
  [ "${issuer}" = "https://$(val '.issuerBase')/oidc/${NAME}" ] || warn "issuer ${issuer} is not https://<issuerBase>/oidc/${NAME}"
  if [ -z "${node_exec}" ]; then
    node="$(kubectl --context "${NAME}" get nodes -l node-role.kubernetes.io/control-plane -o name | head -n1)"
    node="${node#node/}"; [ -n "${node}" ] || die "no control-plane node found on ${NAME}"
    prefix="$(val '.runtime.nodeExec')"; [ -n "${prefix}" ] || die "resolved values have no runtime.nodeExec: pass --node-exec"
    node_exec="${prefix} ${node}"
  fi
  step "identity: ${NAME} -> ${issuer} (node exec: ${node_exec})"
  bash "${APRON_ROOT}/hack/cluster-identity.sh" issuer --context "${NAME}" --node-exec "${node_exec}" --issuer "${issuer}" ${extra[@]+"${extra[@]}"}
}

# --- subcommands: verify, resume, down ------------------------------------------------------------------------------
parse_out() {
  OUT=""; YES=false
  while [ $# -gt 0 ]; do case "$1" in --out) OUT="$2"; shift 2 ;; --yes) YES=true; shift ;; --dry-run) DRY_RUN=true; shift ;;
    *) die "unknown argument $1" ;; esac; done
  need_cluster_dir "${OUT}"; load_values "${OUT}"
}

cmd_verify() {
  [ "${1:-}" != --help ] && [ "${1:-}" != -h ] || { echo "apron verify --out DIR   runtime health, then Argo CD Applications (read-only)"; return 0; }
  parse_out "$@"
  step "runtime"
  case "${RUNTIME}" in
    kiac) kiac verify cluster --name "${NAME}" || warn "kiac verify reported problems" ;;
    *) kubectl --context "${NAME}" get --raw /readyz >/dev/null && ok "API server ready"; kubectl --context "${NAME}" get nodes ;;
  esac
  step "Argo CD Applications"
  kubectl --context "${NAME}" get applications.argoproj.io -A -o json | jq -r '
    .items[] | [.metadata.namespace, .metadata.name, (.status.sync.status // "-"), (.status.health.status // "-")] | @tsv' \
    | sort | column -t
}

cmd_resume() {
  [ "${1:-}" != --help ] && [ "${1:-}" != -h ] || { echo "apron resume --out DIR   restart a stopped kiac/kind cluster, fix its context, print /etc/hosts lines"; return 0; }
  parse_out "$@"
  local engine="${APRON_CONTAINER_ENGINE:-docker}"
  case "${RUNTIME}" in
    kiac) run kiac resume cluster --name "${NAME}" ;;
    kind) local ids; ids="$("${engine}" ps -aq --filter "label=io.x-k8s.kind.cluster=${NAME}")"
          [ -n "${ids}" ] || die "no ${engine} containers for kind cluster ${NAME}"
          # shellcheck disable=SC2086
          run "${engine}" start ${ids} ;;
    existing) die "runtime existing: nothing to resume" ;;
  esac
  ensure_context ""
  kiac_max_pods
  local ip domain hosts
  domain="$(val '.domain')"; [ -n "${domain}" ] || die "resolved values have no domain"
  if [ "${RUNTIME}" = kind ]; then ip=127.0.0.1
  else ip="$(kubectl --context "${NAME}" get nodes -l node-role.kubernetes.io/control-plane \
      -o jsonpath='{.items[0].status.addresses[?(@.type=="InternalIP")].address}')"; fi
  hosts="$(jq -r '(.hostnames // []) | join(" ")' <<<"${VALUES}")"; [ -n "${hosts}" ] || hosts="argocd.${domain}"
  step "/etc/hosts (not edited; add or replace these yourself)"
  echo "${ip} ${hosts}"
}

cmd_down() {
  [ "${1:-}" != --help ] && [ "${1:-}" != -h ] || { echo "apron down --out DIR --yes   delete a kiac/kind cluster (refused for existing)"; return 0; }
  parse_out "$@"
  [ "${YES}" = true ] || die "down deletes cluster ${NAME} and everything on it: pass --yes"
  case "${RUNTIME}" in
    kiac) run kiac delete cluster --name "${NAME}" ;;
    kind) run kind delete cluster --name "${NAME}" ;;
    existing) die "runtime existing: apron never deletes a cluster it did not create" ;;
  esac
  if kubectl config get-contexts -o name 2>/dev/null | grep -qx "${NAME}"; then run kubectl config delete-context "${NAME}"; fi
}

# --- main -----------------------------------------------------------------------------------------------------------
usage() { cat <<'EOF'
apron: deploy Hangar onto a Kubernetes cluster

  init <dev|prod>  write, validate and render a cluster repo (cluster.yaml) and set up git/GitHub
  render           re-render a cluster repo after editing cluster.yaml
  up               create (kiac/kind) or check (existing) the cluster, then onboard it
  fleet            add a cluster to the fleet's clusters.yaml; set the fleet's Infisical
  identity         give a kiac/kind cluster its own ServiceAccount issuer
  verify           runtime health and Argo CD Applications
  resume           restart a stopped local cluster
  down             delete a local cluster

apron <command> --help for flags. Reference: docs/cli.md
EOF
}
main() {
  local cmd="${1:-help}"; [ $# -gt 0 ] && shift
  case "${cmd}" in
    init) cmd_init "$@" ;; render) cmd_render "$@" ;; up) cmd_up "$@" ;; fleet) cmd_fleet "$@" ;;
    identity) cmd_identity "$@" ;; verify) cmd_verify "$@" ;; resume) cmd_resume "$@" ;; down) cmd_down "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command ${cmd}" ;;
  esac
}
main "$@"
